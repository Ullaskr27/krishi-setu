{
  "entities": {
    "FarmerProfile": {
      "title": "FarmerProfile",
      "description": "Private farmer profile storing identity, location, land size, and language preference.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the farmer."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full name of the farmer."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150,
          "description": "Verified email address of the farmer."
        },
        "mobile": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "description": "Contact phone number."
        },
        "village": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Village or taluk name."
        },
        "district": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "District name."
        },
        "state": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "State name."
        },
        "landArea": {
          "type": "number",
          "description": "Total agricultural land area in acres."
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "kn", "hi", "ta", "te", "mr"],
          "description": "Preferred UI and Voice AI language code."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "mobile",
        "village",
        "district",
        "state",
        "landArea",
        "preferredLanguage",
        "createdAt",
        "updatedAt"
      ]
    },
    "FarmPlot": {
      "title": "FarmPlot",
      "description": "A managed farm plot owned by a farmer.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the farmer who owns this plot."
        },
        "farmName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the plot."
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Plot location."
        },
        "landArea": {
          "type": "number",
          "description": "Plot size in acres."
        },
        "soilType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Soil classification."
        },
        "cropsPlanted": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Crops currently planted on this plot."
        },
        "plantingDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30,
          "description": "ISO date string for sowing."
        },
        "expectedHarvestDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30,
          "description": "ISO date string for expected harvest."
        },
        "status": {
          "type": "string",
          "enum": ["Growing", "Ready for Harvest", "Planted", "Fallow"],
          "description": "Current crop lifecycle status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "ownerId",
        "farmName",
        "location",
        "landArea",
        "soilType",
        "cropsPlanted",
        "plantingDate",
        "expectedHarvestDate",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "CropAdvisoryHistory": {
      "title": "CropAdvisoryHistory",
      "description": "Saved soil NPK test and smart crop recommendation record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the farmer who ran the evaluation."
        },
        "nitrogen": { "type": "number" },
        "phosphorus": { "type": "number" },
        "potassium": { "type": "number" },
        "ph": { "type": "number" },
        "temperature": { "type": "number" },
        "rainfall": { "type": "number" },
        "location": { "type": "string", "minLength": 1, "maxLength": 120 },
        "season": { "type": "string", "enum": ["Kharif", "Rabi", "Zaid"] },
        "availableWater": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "landSize": { "type": "number" },
        "bestCropName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "suitabilityScore": { "type": "number" },
        "soilAnalysisNotes": { "type": "string", "minLength": 0, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "nitrogen",
        "phosphorus",
        "potassium",
        "ph",
        "temperature",
        "rainfall",
        "location",
        "season",
        "availableWater",
        "landSize",
        "bestCropName",
        "suitabilityScore",
        "soilAnalysisNotes",
        "createdAt"
      ]
    },
    "AdvisoryLog": {
      "title": "AdvisoryLog",
      "description": "Chronological farmer history entry covering crop, disease, irrigation, fertilizer, and voice AI consultations.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["crop", "disease", "irrigation", "fertilizer", "voice"]
        },
        "cropName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "metricLabel": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "language": {
          "type": "string",
          "enum": ["en", "kn", "hi", "ta", "te", "mr"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "category",
        "cropName",
        "title",
        "summary",
        "metricLabel",
        "language",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/farmers/{farmerId}": {
      "schema": { "$ref": "#/entities/FarmerProfile" },
      "description": "Private farmer account profile document keyed by Firebase Auth UID."
    },
    "/farmers/{farmerId}/farms/{farmId}": {
      "schema": { "$ref": "#/entities/FarmPlot" },
      "description": "Subcollection of farm plots belonging to a farmer."
    },
    "/farmers/{farmerId}/cropHistory/{historyId}": {
      "schema": { "$ref": "#/entities/CropAdvisoryHistory" },
      "description": "Subcollection of saved past soil NPK & crop recommendation evaluations."
    },
    "/farmers/{farmerId}/advisoryLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdvisoryLog" },
      "description": "Unified chronological history of all farmer consultations and analyses."
    }
  }
}
